# Configure a trusted server-side email relay endpoint. It must accept JSON POSTs.
# The endpoint receives { to, subject, replyTo, text, enquiry }.
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
ENQUIRY_TO_EMAIL=
PORT=4173

# Digits only, including the US country code (for example, 1 plus the 10 digit number).
VITE_WHATSAPP_NUMBER=

# Set only when a trusted reverse proxy strips and sets X-Forwarded-For.
TRUST_PROXY=false
